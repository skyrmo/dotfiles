[
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-alt-space": [
        "action::Sequence",
        [
          ["workspace::ToggleRightDock", null],
          ["workspace::ToggleLeftDock", null]
        ]
      ]
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "shift-h": "project_panel::ToggleHideHidden"
    }
  }
]
